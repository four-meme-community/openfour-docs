# Same deployer key as developer/fork-deploy. Leave SIGNER unset so it defaults to the deployer.
# developer/.env is also loaded.
# Default public BSC Testnet RPC. Do not commit private RPC keys.
RPC_URL=https://bsc-testnet.publicnode.com
BSC_TESTNET_RPC_URL=https://bsc-testnet.publicnode.com
DEPLOYER_PRIVATE_KEY=
FORK_JSON=../fork-deploy/out/fork-deployment.json
PRESET=fairlaunch
# Optional: PRESET_ID, TOKEN_NAME, TOKEN_SYMBOL, QUOTE_ASSET, CREATE_FEE
# DURATION=604800  # seconds; 0 allows immediate migrate
# MIGRATE=1        # call core.migrate after buy/sell (needs timeout/sellout/DURATION=0)
# loop.sell=false in the preset JSON skips sell
