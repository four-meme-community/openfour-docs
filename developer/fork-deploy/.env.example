# Reads and deploys through this RPC. Must be a deployed testnet, or a fork of it (anvil --fork-url).
# Default public BSC Testnet RPC. Do not commit private RPC keys.
RPC_URL=https://bsc-testnet.publicnode.com
# BSC_TESTNET_RPC_URL is also accepted.

# Owner of the new set. Optional when DRY_RUN=1.
DEPLOYER_PRIVATE_KEY=

# Defaults to the deployer. Leave SIGNER_ADDRESS empty so the new set can sign creates itself.
TREASURY_ADDRESS=
SIGNER_ADDRESS=
# Developer-fee recipient for the preset. Defaults to the deployer.
PRESET_AUTHOR=

# Default ./source/bsctestnet.json; usually no change needed
SOURCE_DEPLOYMENT=

# Any ERC1967 proxy deploy tx from this set. Default is the current bsctestnet Registry proxy deploy tx.
# The script only extracts proxy creation bytecode from this tx input, then swaps in the new impl and initialize args.
PROXY_DEPLOY_TX=0xc5e66936272ac4779c5c8388becbd86b0569a42b9ace144b174d0a5428b4620e

# 1 = read on-chain state and print the plan, do not send transactions
DRY_RUN=1
