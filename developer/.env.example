# Shared by startup and fork-deploy. Child-directory .env files still override.
# Default public BSC Testnet RPC. Do not commit private RPC keys.
RPC_URL=https://bsc-testnet.publicnode.com
BSC_TESTNET_RPC_URL=https://bsc-testnet.publicnode.com
DEPLOYER_PRIVATE_KEY=
# Leave FORK_JSON empty to use fork-deploy/out/fork-deployment.json
FORK_JSON=
PRESET=fairlaunch
# Optional create overrides: TOKEN_NAME TOKEN_SYMBOL PRESET_ID DURATION MIGRATE=1
